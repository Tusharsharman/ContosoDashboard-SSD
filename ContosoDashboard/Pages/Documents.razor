@page "/documents"
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json

<h3>My Documents</h3>
<_DocumentUpload OnUploaded="LoadDocuments" />

<div>
    <label>
        Search
        <input @bind="searchText" @bind:event="oninput" placeholder="Search title, description, or tags" />
    </label>
    <label>
        Category
        <select @bind="selectedCategory">
            <option value="">All categories</option>
            @foreach (var category in categories)
            {
                <option value="@category">@category</option>
            }
        </select>
    </label>
    <label>
        Project ID
        <input type="number" @bind="projectIdFilter" placeholder="Any project" />
    </label>
    <label>
        Sort by
        <select @bind="sortField">
            <option value="date">Upload date</option>
            <option value="title">Title</option>
            <option value="size">File size</option>
        </select>
    </label>
    <label>
        Direction
        <select @bind="sortDescending">
            <option value="true">Descending</option>
            <option value="false">Ascending</option>
        </select>
    </label>
</div>

<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Uploaded</th>
            <th>Size</th>
            <th>Project</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in FilteredDocuments)
        {
            <tr>
                <td>@d.Title</td>
                <td>@d.Category</td>
                <td>@d.UploadDateUtc</td>
                <td>@d.FileSizeBytes</td>
                <td>@(d.ProjectId?.ToString() ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<DocumentDto> documents = new();
    private string searchText = string.Empty;
    private string selectedCategory = string.Empty;
    private int? projectIdFilter;
    private string sortField = "date";
    private bool sortDescending = true;

    private IEnumerable<string> categories => documents
        .Select(d => d.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category);

    private IEnumerable<DocumentDto> FilteredDocuments
    {
        get
        {
            var query = documents.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(d =>
                    d.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (d.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.Tags?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(selectedCategory))
            {
                query = query.Where(d => string.Equals(d.Category, selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            if (projectIdFilter.HasValue)
            {
                query = query.Where(d => d.ProjectId == projectIdFilter.Value);
            }

            query = sortField switch
            {
                "title" => sortDescending
                    ? query.OrderByDescending(d => d.Title)
                    : query.OrderBy(d => d.Title),
                "size" => sortDescending
                    ? query.OrderByDescending(d => d.FileSizeBytes)
                    : query.OrderBy(d => d.FileSizeBytes),
                _ => sortDescending
                    ? query.OrderByDescending(d => d.UploadDateUtc)
                    : query.OrderBy(d => d.UploadDateUtc)
            };

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        var client = HttpClientFactory.CreateClient();
        var resp = await client.GetFromJsonAsync<DocumentListResponse>("/api/documents/my");
        if (resp?.items != null)
        {
            documents = resp.items;
        }
    }

    private class DocumentDto
    {
        public int DocumentId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Category { get; set; } = string.Empty;
        public string? Tags { get; set; }
        public DateTime UploadDateUtc { get; set; }
        public long FileSizeBytes { get; set; }
        public int? ProjectId { get; set; }
    }

    private class DocumentListResponse
    {
        public List<DocumentDto>? items { get; set; }
        public int total { get; set; }
    }
}
